# Keep text byte-identical across Windows (SMAX) and CI so media sha256 and
# byte-equality tests agree. Library media are binary.
*.json text eol=lf
*.ts text eol=lf
*.mts text eol=lf
*.rs text eol=lf
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.toml text eol=lf
*.css text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.wav binary
*.png binary
*.onnx binary
*.bin binary
