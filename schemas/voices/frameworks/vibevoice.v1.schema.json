{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darbotlabs.dev/gen-audio/voices/frameworks/vibevoice.v1.schema.json",
  "title": "VibeVoiceParams",
  "description": "Long-form VibeVoice reference prompt. file_stem matches <lang>-<Name>_<gender>[_bgm].wav. Languages in DarbotLM/genaid-voices are en, zh, and in (in-Samuel_man), not only en and zh. _bgm is a real suffix (en-Mary_woman_bgm, zh-Anchen_man_bgm). model_size is optional because a reference WAV is not pinned to the 1.5B or 7B checkpoint. cfg_scale and diffusion_steps are inference knobs, not file properties. At most 4 speakers.",
  "type": "object",
  "additionalProperties": false,
  "required": ["file_stem", "sample_rate", "max_speakers", "background_music"],
  "properties": {
    "model_size": { "enum": ["1.5B", "7B"] },
    "model_id": { "enum": ["microsoft/VibeVoice-1.5B", "microsoft/VibeVoice-Large"] },
    "file_stem": { "type": "string", "pattern": "^[a-z]{2,3}-[A-Za-z0-9]+_(man|woman|neutral)(_bgm)?$" },
    "cfg_scale": { "type": "number", "minimum": 0.5, "maximum": 5 },
    "diffusion_steps": { "type": "integer", "minimum": 1, "maximum": 100 },
    "sample_rate": { "const": 24000 },
    "max_speakers": { "const": 4 },
    "background_music": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": { "properties": { "model_size": { "const": "1.5B" } }, "required": ["model_size"] },
      "then": { "properties": { "model_id": { "const": "microsoft/VibeVoice-1.5B" } } }
    },
    {
      "if": { "properties": { "model_size": { "const": "7B" } }, "required": ["model_size"] },
      "then": { "properties": { "model_id": { "const": "microsoft/VibeVoice-Large" } } }
    }
  ]
}
