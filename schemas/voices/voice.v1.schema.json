{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darbotlabs.dev/gen-audio/voices/voice.v1.schema.json",
  "title": "VoiceDescriptor",
  "description": "Common voice descriptor, schema_version 1.0.0. Framework-specific synthesis knobs live in params and are checked against that framework's schema. The framework id is an open slug so a new backend can register without forking this document. This is not a persona voice_profile.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "display_name", "language", "gender", "framework", "assets", "source", "tags", "params"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,31}\\.[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "description": "framework + '.' + local id, for example kokoro_onnx.af_heart or vibevoice.en-Alice_woman."
    },
    "display_name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[a-z0-9]{2,8})?$",
      "description": "BCP-47-style tag, or a framework code where that is the published voice key (jp, sp, kr on livevoice)."
    },
    "gender": { "enum": ["female", "male", "neutral", "unspecified"] },
    "framework": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/asset" }
    },
    "source": { "$ref": "#/$defs/source" },
    "tags": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$" }
    },
    "g2p": {
      "type": "string",
      "pattern": "^misaki\\.[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "description": "Id of a Misaki G2P config this voice uses. Omit when the framework does not use Misaki."
    },
    "params": { "type": "object" }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "format"],
      "properties": {
        "role": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 220,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./+-]*$",
          "description": "Path relative to GENAID_VOICES_DIR. No absolute path, drive, or '..' segment."
        },
        "format": { "enum": ["pt", "npz", "onnx", "wav", "bin", "json"] },
        "member": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Name inside a pack, such as a Kokoro style-vector key."
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "license"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "url": { "type": "string", "pattern": "^https://[^\\s]+$", "maxLength": 300 },
        "license": { "type": "string", "minLength": 1, "maxLength": 80 },
        "attribution": { "type": "string", "minLength": 1, "maxLength": 400 }
      }
    }
  }
}
