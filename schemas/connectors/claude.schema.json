{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/darbotlabs/gen-audio/schemas/connectors/claude.schema.json",
  "title": "ClaudeConnectorConfig",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "ANTHROPIC_API_KEY": { "type": "string", "minLength": 1, "maxLength": 8192, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" },
    "ANTHROPIC_MODEL": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^(?!.*\\.\\.)[A-Za-z0-9._-]+$", "default": "claude-3-5-haiku-latest" },
    "CLAUDE_CODE_BIN": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^\\u0000-\\u001f\\u007f]+$", "description": "Optional path to a binary named claude or claude.exe. No shell invocation." },
    "GEN_AUDIO_CLAUDE_CODE_CLI": { "enum": ["0", "1"], "description": "Must be 1 before the CLI is spawned." },
    "GEN_AUDIO_CONNECTOR_LIVE": { "enum": ["0", "1"] }
  }
}
