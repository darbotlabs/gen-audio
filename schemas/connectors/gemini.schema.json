{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/darbotlabs/gen-audio/schemas/connectors/gemini.schema.json",
  "title": "GeminiConnectorConfig",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "GEMINI_API_KEY": { "type": "string", "minLength": 1, "maxLength": 8192, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" },
    "GOOGLE_API_KEY": { "type": "string", "minLength": 1, "maxLength": 8192, "pattern": "^[^\\u0000-\\u001f\\u007f]+$", "description": "Fallback if GEMINI_API_KEY is unset." },
    "GEMINI_MODEL": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^(?!.*\\.\\.)[A-Za-z0-9._-]+$", "default": "gemini-2.0-flash" },
    "GEN_AUDIO_CONNECTOR_LIVE": { "enum": ["0", "1"] }
  }
}
