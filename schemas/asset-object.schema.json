          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "hop_frames": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "n_bands": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "width_px": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "height_px": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
