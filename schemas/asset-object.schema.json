      },
      "properties": {
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sample_rate_hz": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "bin_frames": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "time_bins": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "freq_bins": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "covers_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "inv_hdr_ppm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cube_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
