{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/darbotlabs/gen-audio/schemas/card-viewport.schema.json",
  "title": "GenAudioCardViewport",
  "description": "Snap-scroll board of Gen-Audio cards. Adaptive Card payloads are optional companions, not a second source of truth.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "title", "cards"],
  "properties": {
    "version": { "const": "1.0" },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "columns": { "type": "integer", "minimum": 1, "maximum": 4 },
    "cards": {
      "type": "array",
      "items": { "$ref": "#/$defs/card" }
    }
  },
  "$defs": {
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "body"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$(?![\\s\\S])" },
        "uid": { "type": "string", "pattern": "^ga:card:[a-z2-7]{25}[aeimquy4]$(?![\\s\\S])", "description": "v1 asset uid (asset-object.schema.json). id stays the runtime handle." },
        "kind": {
          "enum": [
            "EngineStatus",
            "SpectrogramPanel",
            "Cube3D",
            "PodcastCast",
            "ServeHealth",
            "BenchmarkCompare",
            "ConnectorStatus",
            "LibraryClip",
            "VoiceProfile"
          ]
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "span": { "type": "integer", "minimum": 1, "maximum": 3 },
        "body": { "type": "object" },
        "adaptive": { "$ref": "#/$defs/adaptiveCard" }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "EngineStatus" } } }, "then": { "properties": { "body": { "$ref": "#/$defs/engineStatus" } } } },
        { "if": { "properties": { "kind": { "const": "SpectrogramPanel" } } }, "then": { "properties": { "body": { "$ref": "#/$defs/visual" } } } },
        { "if": { "properties": { "kind": { "const": "Cube3D" } } }, "then": { "properties": { "body": { "$ref": "#/$defs/visual" } } } },
        { "if": { "properties": { "kind": { "const": "PodcastCast" } } }, "then": { "properties": { "body": { "$ref": "#/$defs/podcastCast" } } } },
        { "if": { "properties": { "kind": { "const": "ServeHealth" } } }, "then": { "properties": { "body": { "$ref": "#/$defs/serveHealth" } } } },
        { "if": { "properties": { "kind": { "const": "BenchmarkCompare" } } }, "then": { "properties": { "body": { "$ref": "#/$defs/benchmark" } } } },
        { "if": { "properties": { "kind": { "const": "ConnectorStatus" } } }, "then": { "properties": { "body": { "$ref": "#/$defs/connectorStatus" } } } },
        { "if": { "properties": { "kind": { "const": "LibraryClip" } } }, "then": { "properties": { "body": { "$ref": "#/$defs/libraryClip" } } } },
        { "if": { "properties": { "kind": { "const": "VoiceProfile" } } }, "then": { "properties": { "body": { "$ref": "#/$defs/voiceProfile" } } } }
      ]
    },
    "engineStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engineId", "status", "summary"],
      "properties": {
        "engineId": { "type": "string", "minLength": 1, "maxLength": 40 },
        "status": { "enum": ["implemented", "external", "library", "weights_absent", "unavailable"] },
        "summary": { "type": "string", "minLength": 1, "maxLength": 400 }
      }
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "notPodcast", "disclaimer"],
      "properties": {
        "source": { "const": "fixture-tone" },
        "notPodcast": { "const": true },
        "disclaimer": { "type": "string", "minLength": 12, "maxLength": 400, "pattern": "[Nn][Oo][Tt]" }
      }
    },
    "podcastCast": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sampleScript", "speakers"],
      "properties": {
        "sampleScript": { "const": true },
        "speakers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "voice"],
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 8 },
              "name": { "type": "string", "minLength": 1, "maxLength": 40 },
              "voice": { "type": "string", "minLength": 1, "maxLength": 40 }
            }
          }
        }
      }
    },
    "serveHealth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port", "baseUrl", "healthUrl", "probed", "role"],
      "properties": {
        "host": { "type": "string", "minLength": 1, "maxLength": 80 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "baseUrl": { "$ref": "#/$defs/httpUrl", "maxLength": 200 },
        "healthUrl": { "$ref": "#/$defs/httpUrl", "maxLength": 220 },
        "probed": { "type": "boolean" },
        "ok": { "type": "boolean" },
        "role": { "enum": ["node", "shared-gateway"] }
      },
      "if": { "properties": { "probed": { "const": true } }, "required": ["probed"] },
      "then": { "required": ["ok"] }
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["measuredHere", "rows"],
      "properties": {
        "measuredHere": { "type": "boolean" },
        "sourceNote": { "type": "string", "minLength": 12, "maxLength": 400 },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["engine", "metric", "value"],
            "properties": {
              "engine": { "type": "string", "minLength": 1, "maxLength": 40 },
              "metric": { "type": "string", "minLength": 1, "maxLength": 40 },
              "value": { "type": ["number", "string"] },
              "unit": { "type": "string" },
              "note": { "type": "string" }
            }
          }
        }
      },
      "if": { "properties": { "measuredHere": { "const": false } }, "required": ["measuredHere"] },
      "then": {
        "required": ["sourceNote"],
        "properties": {
          "sourceNote": { "pattern": "[Nn][Oo][Tt] ([Rr][Ee])?[Mm][Ee][Aa][Ss][Uu][Rr][Ee][Dd]" }
        }
      },
      "else": {
        "properties": {
          "sourceNote": { "not": { "pattern": "[Nn][Oo][Tt] ([Rr][Ee])?[Mm][Ee][Aa][Ss][Uu][Rr][Ee][Dd]" } }
        }
      }
    },
    "libraryClip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engineId", "status", "synthesizedSpeech", "summary"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "engineId": { "type": "string", "minLength": 1, "maxLength": 40 },
        "status": { "enum": ["ok", "running", "weights_absent", "unavailable", "external"] },
        "synthesizedSpeech": { "type": "boolean" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 400 },
        "wavUrl": { "$ref": "#/$defs/libraryUrl", "pattern": "\\.wav$" },
        "duration_s": { "type": "number", "exclusiveMinimum": 0 },
        "sample_rate": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "cubePngUrl": { "$ref": "#/$defs/libraryUrl" },
        "cubeJsonUrl": { "$ref": "#/$defs/libraryUrl" },
        "sidecarUrl": { "$ref": "#/$defs/libraryUrl" },
        "semanticName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "faceName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "inv_hdr": { "type": "number" }
      },
      "if": { "properties": { "synthesizedSpeech": { "const": true } }, "required": ["synthesizedSpeech"] },
      "then": { "required": ["wavUrl", "duration_s", "sample_rate"] },
      "else": { "not": { "required": ["wavUrl"] } }
    },
    "voiceProfile": {
      "$ref": "https://darbotlabs.dev/gen-audio/voice-profile.schema.json"
    },
    "connectorStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connectorId", "mode", "authenticated", "detail"],
      "properties": {
        "connectorId": { "enum": ["mcp", "acp", "harness", "copilot", "claude", "gpt", "gemini", "local"] },
        "mode": { "enum": ["mock", "live", "local", "token_present", "misconfigured"] },
        "authenticated": { "type": "boolean" },
        "detail": { "type": "string", "minLength": 1, "maxLength": 400 }
      }
    },
    "adaptiveCard": {
      "type": "object",
      "required": ["type", "version", "body"],
      "properties": {
        "type": { "const": "AdaptiveCard" },
        "version": { "type": "string", "minLength": 1, "maxLength": 8 },
        "$schema": { "const": "http://adaptivecards.io/schemas/adaptive-card.json" },
        "body": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "object" }
        }
      }
    },
    "libraryUrl": {
      "type": "string",
      "maxLength": 260,
      "pattern": "^/library/(?!.*\\.\\.)[A-Za-z0-9_-][A-Za-z0-9_.-]{0,127}(/[A-Za-z0-9_-][A-Za-z0-9_.-]{0,127}){0,3}$(?![\\s\\S])"
    },
    "httpUrl": {
      "type": "string",
      "pattern": "^https?://[^/\\\\\\s@?#]+(/[^\\\\\\s]*)?$(?![\\s\\S])"
    }
  }
}
