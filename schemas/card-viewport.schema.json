{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/darbotlabs/gen-audio/schemas/card-viewport.schema.json",
  "title": "GenAudioCardViewport",
  "description": "Snap-scroll board of Gen-Audio cards. Adaptive Card payloads are optional companions, not a second source of truth.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "title", "cards"],
  "properties": {
    "version": { "const": "1.0" },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "columns": { "type": "integer", "minimum": 1, "maximum": 4 },
    "cards": {
      "type": "array",
      "items": { "$ref": "#/$defs/card" }
    }
  },
  "$defs": {
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "body"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
        "kind": {
          "enum": [
            "EngineStatus",
            "SpectrogramPanel",
            "Cube3D",
            "PodcastCast",
            "ServeHealth",
            "BenchmarkCompare",
            "ConnectorStatus",
            "LibraryClip",
            "VoiceProfile"
          ]
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "span": { "type": "integer", "minimum": 1, "maximum": 3 },
        "body": { "type": "object" },
        "adaptive": { "$ref": "#/$defs/adaptiveCard" }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "EngineStatus" } } }, "then": { "properties": { "body": { "$ref": "#/$defs/engineStatus" } } } },
        { "if": { "properties": { "kind": { "const": "SpectrogramPanel" } } }, "then": { "properties": { "body": { "$ref": "#/$defs/visual" } } } },
        { "if": { "properties": { "kind": { "const": "Cube3D" } } }, "then": { "properties": { "body": { "$ref": "#/$defs/visual" } } } },
        { "if": { "properties": { "kind": { "const": "PodcastCast" } } }, "then": { "properties": { "body": { "$ref": "#/$defs/podcastCast" } } } },
        { "if": { "properties": { "kind": { "const": "ServeHealth" } } }, "then": { "properties": { "body": { "$ref": "#/$defs/serveHealth" } } } },
        { "if": { "properties": { "kind": { "const": "BenchmarkCompare" } } }, "then": { "properties": { "body": { "$ref": "#/$defs/benchmark" } } } },
        { "if": { "properties": { "kind": { "const": "ConnectorStatus" } } }, "then": { "properties": { "body": { "$ref": "#/$defs/connectorStatus" } } } },
        { "if": { "properties": { "kind": { "const": "LibraryClip" } } }, "then": { "properties": { "body": { "$ref": "#/$defs/libraryClip" } } } },
        { "if": { "properties": { "kind": { "const": "VoiceProfile" } } }, "then": { "properties": { "body": { "$ref": "#/$defs/voiceProfile" } } } }
      ]
    },
    "engineStatus": {
      "type": "object",
      "required": ["engineId", "status", "summary"],
      "properties": {
        "engineId": { "type": "string" },
        "status": { "enum": ["implemented", "external", "library", "weights_absent", "unavailable"] },
        "summary": { "type": "string" }
      }
    },
    "visual": {
      "type": "object",
      "required": ["source", "notPodcast", "disclaimer"],
      "properties": {
        "source": { "const": "fixture-tone" },
        "notPodcast": { "const": true },
        "disclaimer": { "type": "string", "minLength": 12, "pattern": "[Nn]ot" }
      }
    },
    "podcastCast": {
      "type": "object",
      "required": ["sampleScript", "speakers"],
      "properties": {
        "sampleScript": { "const": true },
        "speakers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "name", "voice"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "voice": { "type": "string" }
            }
          }
        }
      }
    },
    "serveHealth": {
      "type": "object",
      "required": ["host", "port", "baseUrl", "healthUrl", "probed", "role"],
      "properties": {
        "host": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "baseUrl": { "type": "string" },
        "healthUrl": { "type": "string" },
        "probed": { "type": "boolean" },
        "ok": { "type": "boolean" },
        "role": { "enum": ["node", "shared-gateway"] }
      }
    },
    "benchmark": {
      "type": "object",
      "required": ["measuredHere", "sourceNote", "rows"],
      "properties": {
        "measuredHere": { "const": false },
        "sourceNote": { "type": "string", "minLength": 12, "pattern": "[Nn]ot remeasured" },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["engine", "metric", "value"],
            "properties": {
              "engine": { "type": "string" },
              "metric": { "type": "string" },
              "value": { "type": ["number", "string"] },
              "unit": { "type": "string" },
              "note": { "type": "string" }
            }
          }
        }
      }
    },
    "libraryClip": {
      "type": "object",
      "required": ["engineId", "status", "synthesizedSpeech", "summary"],
      "properties": {
        "engineId": { "type": "string" },
        "status": { "enum": ["ok", "running", "weights_absent", "unavailable", "external"] },
        "synthesizedSpeech": { "type": "boolean" },
        "summary": { "type": "string" },
        "wavUrl": { "type": "string" },
        "duration_s": { "type": "number" },
        "sample_rate": { "type": "integer" },
        "cubePngUrl": { "type": "string" },
        "cubeJsonUrl": { "type": "string" },
        "sidecarUrl": { "type": "string" },
        "semanticName": { "type": "string" },
        "faceName": { "type": "string" },
        "inv_hdr": { "type": "number" }
      }
    },
    "voiceProfile": {
      "description": "Canonical fields also live in schemas/voice_profile.schema.json. agentName is a persona. voiceModel is a TTS id. af_heart belongs in refs.",
      "type": "object",
      "additionalProperties": false,
      "required": ["agentName", "personaId", "voiceModel", "tone", "purpose", "domain", "accent", "traits", "refs", "spectrogram2d", "spectrogram3d", "notPodcast", "disclaimer"],
      "properties": {
        "agentName": { "type": "string", "minLength": 1, "maxLength": 40 },
        "personaId": { "type": "string" },
        "voiceModel": { "type": "string" },
        "tone": { "type": "string" },
        "purpose": { "type": "string" },
        "domain": { "type": "string" },
        "accent": { "type": "string" },
        "traits": { "type": "string", "minLength": 12 },
        "refs": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string" } },
        "spectrogram2d": { "const": "browser-profile-map" },
        "spectrogram3d": { "enum": ["none", "library-cube-hook", "fixture-cube"] },
        "cubeJsonUrl": { "type": "string" },
        "notPodcast": { "const": true },
        "synthesizedSpeech": { "const": false },
        "disclaimer": { "type": "string", "minLength": 12 }
      }
    },
    "connectorStatus": {
      "type": "object",
      "required": ["connectorId", "mode", "authenticated", "detail"],
      "properties": {
        "connectorId": { "enum": ["mcp", "acp", "harness", "copilot", "claude", "gpt", "gemini", "local"] },
        "mode": { "enum": ["mock", "live", "local", "token_present", "misconfigured"] },
        "authenticated": { "type": "boolean" },
        "detail": { "type": "string" }
      }
    },
    "adaptiveCard": {
      "type": "object",
      "required": ["type", "version", "body"],
      "properties": {
        "type": { "const": "AdaptiveCard" },
        "version": { "type": "string" },
        "$schema": { "const": "http://adaptivecards.io/schemas/adaptive-card.json" },
        "body": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "object" }
        }
      }
    }
  }
}
