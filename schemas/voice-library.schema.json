{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darbotlabs.dev/gen-audio/voice-library.schema.json",
  "title": "Unified managed voice library",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "description",
    "profiles",
    "references"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "description": {
      "type": "string"
    },
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profileVersion",
          "engineManifests"
        ],
        "properties": {
          "profileVersion": {
            "const": "2.0"
          },
          "engineManifests": {
            "$ref": "https://darbotlabs.dev/gen-audio/voice-profile.schema.json#/$defs/engineManifests"
          },
          "tags": {
            "$ref": "https://darbotlabs.dev/gen-audio/voice-profile.schema.json#/properties/tags"
          },
          "samples": {
            "$ref": "https://darbotlabs.dev/gen-audio/voice-profile.schema.json#/properties/samples"
          },
          "linkedProjects": {
            "$ref": "https://darbotlabs.dev/gen-audio/voice-profile.schema.json#/properties/linkedProjects"
          },
          "metadata": {
            "$ref": "https://darbotlabs.dev/gen-audio/voice-profile.schema.json#/properties/metadata"
          },
          "adaptiveCard": {
            "$ref": "https://darbotlabs.dev/gen-audio/voice-profile.schema.json#/properties/adaptiveCard"
          }
        }
      }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "language",
          "locale",
          "file",
          "sha256",
          "bytes",
          "sampleRate",
          "channels",
          "samples",
          "durationSeconds",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]+$"
          },
          "name": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "locale": {
            "type": "string"
          },
          "file": {
            "type": "string",
            "pattern": "^references/[A-Za-z0-9][A-Za-z0-9_-]+\\.wav$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 44,
            "maximum": 2097152
          },
          "sampleRate": {
            "const": 24000
          },
          "channels": {
            "const": 1
          },
          "samples": {
            "type": "integer",
            "minimum": 1,
            "maximum": 720000
          },
          "durationSeconds": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 30
          },
          "source": {
            "type": "object"
          }
        }
      }
    }
  }
}
