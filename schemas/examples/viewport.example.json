      "body": {
        "host": "<node>",
        "port": 8002,
        "baseUrl": "http://<node>:8002/genaid-audio",
        "healthUrl": "http://<node>:8002/genaid-audio/health",
        "probed": false,
        "role": "node"
      }
    },
    {
      "id": "serve-gateway",
      "kind": "ServeHealth",
      "title": "Shared gateway",
      "body": {
        "host": "10.1.8.70",
        "port": 8002,
        "baseUrl": "http://10.1.8.70:8002/genaid-audio",
        "healthUrl": "http://10.1.8.70:8002/genaid-audio/health",
        "probed": false,
        "role": "shared-gateway"
      }
    },
    {
      "id": "bench-ref",
      "kind": "BenchmarkCompare",
      "title": "Compare notes",
      "span": 3,
      "body": {
        "measuredHere": false,
        "sourceNote": "Reference figures from the 2026-10-06 GenAID podcast compare notes. Not remeasured in this repository.",
        "rows": [
          { "engine": "pocket_tts", "metric": "teaser_wer", "value": "22.22%", "unit": "WER", "note": "Short teaser ASR in those notes." },
          { "engine": "vibevoice", "metric": "teaser_wer", "value": "30.00%", "unit": "WER", "note": "Full improved WAV was the preferred publish in those notes." },
          { "engine": "magpie", "metric": "teaser_wer", "value": "42.22%", "unit": "WER", "note": "Short teaser. Hypothesis was short of the reference." },
          { "engine": "vibevoice", "metric": "bw95_hz", "value": "2670.5", "unit": "Hz", "note": "Full improved final. Not a new measurement." },
          { "engine": "kokoro_onnx", "metric": "bw95_hz_raw", "value": "826.9", "unit": "Hz", "note": "Raw file in those notes. Do not rank publish on inv-HDR alone." }
        ]
      }
    },
