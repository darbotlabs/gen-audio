      "title": "Inverse-HDR cube",
      "span": 2,
      "body": {
        "source": "fixture-tone",
        "notPodcast": true,
        "disclaimer": "WebGL point cloud of the same fixture tone. Not a measured podcast cube."
      }
    },
    {
      "id": "cast-sample",
