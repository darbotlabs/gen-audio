{
  "version": "1.0",
  "title": "Darbot Gen-Audio",
  "columns": 3,
  "cards": [
    {
      "id": "engine-kokoro",
      "kind": "EngineStatus",
      "title": "kokoro-onnx",
      "body": {
        "engineId": "kokoro_onnx",
        "status": "weights_absent",
        "summary": "The Python SDK can synthesize when GEN_AUDIO_KOKORO_MODEL and GEN_AUDIO_KOKORO_VOICES point at local files. Those weights are not in this repo."
      },
      "adaptive": {
        "type": "AdaptiveCard",
        "version": "1.5",
        "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
        "body": [
          { "type": "TextBlock", "text": "kokoro-onnx weights are not bundled.", "wrap": true }
        ]
      }
    },
    {
      "id": "engine-vibevoice",
      "kind": "EngineStatus",
      "title": "VibeVoice",
      "body": {
        "engineId": "vibevoice",
        "status": "external",
        "summary": "Compare slot for VibeVoice 1.5B (Alice/Frank in the 2026-10-06 notes). No adapter and no weights in this app."
      }
    },
    {
      "id": "engine-magpie",
      "kind": "EngineStatus",
      "title": "Magpie",
      "body": {
        "engineId": "magpie",
